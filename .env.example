# Optional: swap to an OSM-derived tile provider with sufficient production capacity.
# Template placeholders supported: {z}, {x}, {y}.
# Never put a private API key here; VITE_* variables are exposed to browsers.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# If using a custom provider, set its required attribution markup.
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
